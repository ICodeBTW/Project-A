// See https://containers.dev/implementors/json_reference/ for configuration reference
{
	"name": "Express App",
	"context": "${localWorkspaceFolder}/application/api/app",
	"dockerFile": "${localWorkspaceFolder}/application/api/app/Dockerfile",
	"workspaceFolder": "/app",
	"features": {
		"ghcr.io/devcontainers/features/postgres:1": {
			"version": "15"
		  }
	},
	"customizations": {
		"codespaces": {
			"disableAutomaticConfiguration": true
		  },
	  "vscode": {
		"extensions": [
			"dbaeumer.vscode-eslint",
			"esbenp.prettier-vscode",
			"bierner.color-info",
			"jpoissonnier.vscode-styled-components",
			"visualstudioexptteam.vscodeintellicode",
			"christian-kohler.npm-intellisense",
			"cssho.vscode-svgviewer",
			"eamodio.gitlens",
			"ms-azuretools.vscode-docker",
			"shardulm94.trailing-spaces",
			"davidanson.vscode-markdownlint",
			"IBM.output-colorizer",
			"Gruntfuggly.todo-tree",
			"bierner.emojisense",
			"stkb.rewrap",
			"vscode-icons-team.vscode-icons",
			"github.vscode-pull-request-github",
			"BracketPairColorDLW.bracket-pair-color-dlw",
			"Prisma.prisma"
		],
		"settings": {
				  "files.eol": "\n",
			  "editor.tabSize": 2,
			  "remote.extensionKind": {
				  "ms-azuretools.vscode-docker": "workspace"
			  },
			  "editor.codeActionsOnSave": {
				  "source.fixAll.eslint": "always"
			  },
			  "eslint.validate": [
				  "javascript",
				  "javascriptreact",
				  "typescript",
				  "typescriptreact"
			  ],
			  "editor.formatOnSave": true,
			  "[javascript]": {
				  "editor.defaultFormatter": "esbenp.prettier-vscode",
				  "editor.formatOnSave": false
				},
				"[javascriptreact]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode",
					"editor.formatOnSave": false
				},
				"[typescript]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode",
					"editor.formatOnSave": false
				},
				"[typescriptreact]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode",
					"editor.formatOnSave": false
				},
				"prettier-eslint.eslintIntegration": true
			  }
	  }
	},
	// "mounts": [
	//   {
	// 	"source": "${localWorkspaceFolder}/application/api/app/",
	// 	"target": "/app/",
	// 	"type": "bind"
	//   },
	//   {
	// 	"source": "${localWorkspaceFolderBasename}_node_modules",
	// 	"target": "${containerWorkspaceFolder}/node_modules",
	// 	"type": "volume"
	//   }
	// ],

	"runArgs": [
		"--network=dev"
	],
	"appPort": 3000,
	// "postCreateCommand": "sudo chown node node_modules",
	"postCreateCommand": "sudo service postgresql start",
	"remoteUser": "node"
  }
  